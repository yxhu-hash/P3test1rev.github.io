  { lesson: "三上 2冊 第10課", before: "課堂上如果遇到不懂的詞語，我們要勇敢向老師", after: "請教。", answer: "提問", options: ["提問", "掏", "重複", "掙扎"], hint: "「提問」指提出問題。" },
  { lesson: "三上 2冊 第10課", before: "今天這場大雨非常猛烈，路面的積水", after: "淹到了行人的膝蓋。", answer: "幾乎", options: ["幾乎", "雖然", "逐漸", "重複"], hint: "「幾乎」表示十分接近、差一點。" },
  { lesson: "三上 2冊 第10課", before: "做勞作課時，桌上擺滿了彩紙、膠水和剪刀等各種製作", after: "。", answer: "材料", options: ["材料", "檔案", "噪音", "勝利"], hint: "「材料」指可用於製造器具或成品的物質。" }
];

let currentIndex = 0;
let score = 0;
let canAnswer = true;

function initGame() {
  currentIndex = 0;
  score = 0;
  const scoreEl = document.getElementById('score');
  const totalEl = document.getElementById('q-total');
  const playArea = document.getElementById('play-area');
  const resultArea = document.getElementById('result-area');

  if (scoreEl) scoreEl.innerText = score;
  if (totalEl) totalEl.innerText = quizData.length;
  if (playArea) playArea.style.display = 'block';
  if (resultArea) resultArea.style.display = 'none';

  loadQuestion();
}

function loadQuestion() {
  canAnswer = true;
  const currentQ = quizData[currentIndex];

  document.getElementById('lesson-tag').innerText = currentQ.lesson;
  document.getElementById('q-index').innerText = currentIndex + 1;

  // 修正進度條計算公式，讓第1題能正確顯示當前跨出的第一步
  const progressPercent = ((currentIndex + 1) / quizData.length) * 100;
  document.getElementById('progress').style.width = progressPercent + '%';

  // 渲染題幹
  const questionBox = document.getElementById('question-text');
  questionBox.innerHTML = `${currentQ.before}<span class="blank-placeholder" id="user-blank">（　　）</span>${currentQ.after}`;

  // 隱藏反饋與下一題按鈕
  const feedback = document.getElementById('feedback');
  const nextBtn = document.getElementById('next-btn');
  feedback.style.display = 'none';
  feedback.className = 'feedback-box';
  nextBtn.style.display = 'none';

  // 渲染選項按鈕（打亂順序）
  const optionsGrid = document.getElementById('options-container');
  optionsGrid.innerHTML = '';

  const shuffledOptions = [...currentQ.options].sort(() => Math.random() - 0.5);

  shuffledOptions.forEach(opt => {
    const btn = document.createElement('button');
    btn.className = 'opt-btn';
    btn.innerText = opt;
    btn.onclick = () => selectOption(btn, opt, currentQ);
    optionsGrid.appendChild(btn);
  });
}

function selectOption(selectedBtn, chosenAnswer, currentQ) {
  if (!canAnswer) return;
  canAnswer = false;

  const isCorrect = (chosenAnswer === currentQ.answer);
  const feedback = document.getElementById('feedback');
  const nextBtn = document.getElementById('next-btn');
  const blankEl = document.getElementById('user-blank');
  const allBtns = document.querySelectorAll('.opt-btn');

  if (blankEl) {
    blankEl.innerText = chosenAnswer;
  }

  // 自動解鎖並播放音效
  getAudioContext();

  if (isCorrect) {
    score++;
    document.getElementById('score').innerText = score;
    selectedBtn.classList.add('correct');
    playCorrectSound();
    feedback.innerHTML = `<strong>🎉 太棒了！答對了！</strong><br>${currentQ.hint}`;
    feedback.className = 'feedback-box correct';
  } else {
    selectedBtn.classList.add('wrong');
    playWrongSound();
    allBtns.forEach(btn => {
      if (btn.innerText === currentQ.answer) {
        btn.classList.add('correct');
      }
    });
    feedback.innerHTML = `<strong>❌ 答錯了，再接再厲！</strong><br>正確答案是：<strong>【${currentQ.answer}】</strong><br>${currentQ.hint}`;
    feedback.className = 'feedback-box wrong';
  }

  feedback.style.display = 'block';
  nextBtn.style.display = 'block';
}

function nextQuestion() {
  currentIndex++;
  if (currentIndex < quizData.length) {
    loadQuestion();
  } else {
    showResult();
  }
}

function showResult() {
  document.getElementById('play-area').style.display = 'none';
  const resultArea = document.getElementById('result-area');
  resultArea.style.display = 'block';

  document.getElementById('progress').style.width = '100%';
  document.getElementById('final-score').innerText = `${score} / ${quizData.length}`;

  const evalText = document.getElementById('evaluation-text');
  const ratio = score / quizData.length;
  if (ratio >= 0.9) {
    evalText.innerText = "🌟 詞語大宗師！所有課文詞語你都已經完全掌握了！";
    evalText.style.color = "#15803D";
  } else if (ratio >= 0.7) {
    evalText.innerText = "👍 表現出色！基礎很扎實，多加複習錯題就完美了！";
    evalText.style.color = "#2563EB";
  } else {
    evalText.innerText = "💪 繼續加油！把不熟悉的詞語記在筆記本上多溫習幾次吧！";
    evalText.style.color = "#D97706";
  }
}

function restartGame() {
  initGame();
}

// 頁面載入後自動啟動
window.addEventListener('DOMContentLoaded', () => {
  initGame();
});
</script>
